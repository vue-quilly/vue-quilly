{
  "name": "vue-quilly",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "src/components/",
    "src/composables/"
  ],
  "author": {
    "name": "Oleksandr Shevchuk",
    "email": "alekswebnet@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue-quilly/vue-quilly.git"
  },
  "homepage": "https://github.com/vue-quilly/vue-quilly",
  "bugs": {
    "url": "https://github.com/vue-quilly/vue-quilly/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/vuequilly"
  },
  "keywords": [
    "quill",
    "quill2",
    "wysiwyg",
    "rich-text",
    "html-editor",
    "quill-editor",
    "vue3",
    "vue",
    "vuejs",
    "vue-component",
    "vue-quill",
    "nuxt",
    "nuxt4"
  ],
  "main": "./dist/vue-quilly.umd.cjs",
  "module": "./dist/vue-quilly.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-quilly.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-quilly.umd.cjs"
      }
    }
  },
  "peerDependencies": {
    "quill": "^2.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "quill": "^2.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.30.3"
}